# Template pour le fichier .env
# Copier ce fichier en .env et remplir avec vos vraies valeurs

# ===== VARIABLES SERVEUR (Node.js) =====

# Configuration de l'API Resend
# Obtenir votre clé sur : https://resend.com/api-keys
API_KEY_RESEND=re_VotreClefDAPIResend

# Email de contact qui recevra les messages du formulaire
CONTACT_EMAIL=votre-email@example.com

# Port du serveur API
PORT=3001

# ===== VARIABLES CLIENT (Vite) =====
# Les variables Vite DOIVENT commencer par VITE_ pour être accessibles côté client

# URL de l'API (en production, remplacer par votre domaine)
# En dev: http://localhost:3001
# En prod: https://votre-domaine.com
VITE_API_URL=http://localhost:3001

